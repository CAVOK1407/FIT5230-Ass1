# Local system and editor files
.DS_Store
.idea/
.vscode/

# Python environments and caches
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
.env
.env.*
!.env.example

# Large pretrained models are downloaded separately (see README.md)
/StealthDiffusion/checkpoints/*.pth
/StealthDiffusion/checkpoints/*.pt

# M3: generated data and image outputs stay local (hundreds of MB); records and CSV summaries are kept
/StealthDiffusion/data15/
/StealthDiffusion/data/imagenette2-320*
/StealthDiffusion/results/m3_*/**/*.png
/StealthDiffusion/results/m3_logs/

# M3 LAO v1-v3 and M4: image outputs and fine-tuned weights stay local; records, logs and CSV summaries are kept
/StealthDiffusion/results/**/*.png
/StealthDiffusion/results/**/*.pt
/StealthDiffusion/results/m4_cvae_v1_failed/
/StealthDiffusion/results/m3_lao_*/**/data/

# LPIPS VGG weights are downloaded by the code on first run (528 MB)
/StealthDiffusion/.cache/
