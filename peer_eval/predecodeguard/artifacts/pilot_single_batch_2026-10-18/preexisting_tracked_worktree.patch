--- a/StealthDiffusion/m2_stealth.py
+++ b/StealthDiffusion/m2_stealth.py
@@ -45,6 +45,9 @@ Section "Pipeline configurations", Table of configurations A1-A5 / X1-X6):
                           median surrogate score of the real development images (--real_dev_dir).
                           The paper's capped variant is  --cap auto --pgd_alpha eps/10
                           --pgd_steps 40 --loss margin --kappa cap.
+  --cap_bisect            with --cap: a step that crosses the cap is shortened by bisection so the
+                          score lands at the cap (one sign step of eps/10 can overshoot a sensitive
+                          detector several times over).
   --kappa <float>|cap     margin target of --loss margin; cap = the value of --cap.
   --pgd_eot / --lao_eot none|jpeg|resize|both
                           expectation over transformation: the attack loss is averaged over
@@ -321,7 +324,8 @@ def _mean_std(device):
     return _MEAN_T, _STD_T
 
 
-def pgd_own(pgd_model, x_norm, label, eps, alpha, steps, cap=None, eot="none", eot_jpeg_q=75, eot_resize=0.5):
+def pgd_own(pgd_model, x_norm, label, eps, alpha, steps, cap=None, eot="none", eot_jpeg_q=75, eot_resize=0.5,
+            cap_bisect=False, bisect_iters=10):
     """Returns (adv_norm, info). adv_norm is normalised like the torchattacks output."""
     mean, std = _mean_std(x_norm.device)
     x01 = (x_norm * std + mean).detach()               # torchattacks.inverse_normalize
@@ -341,10 +345,32 @@ def pgd_own(pgd_model, x_norm, label, eps, alpha, steps, cap=None, eot="none", e
             break
         cost = torch.stack([ce(o, label) for o in outs]).mean()
         grad = torch.autograd.grad(cost, adv, retain_graph=False, create_graph=False)[0]
+        prev = adv.detach()
         adv = adv.detach() + alpha * grad.sign()
         delta = torch.clamp(adv - x01, min=-eps, max=eps)
         adv = torch.clamp(x01 + delta, min=0, max=1).detach()
         info["steps"] = step + 1
+        if cap is not None and cap_bisect:
+            # If this step crossed the cap, shrink it by bisection so the score lands just above the
+            # cap instead of far beyond it (a single sign step can overshoot a sensitive detector).
+            with torch.no_grad():
+                m_new = float(real_margin(pgd_model((adv - mean) / std)).item())
+            if m_new >= cap:
+                lo, hi = 0.0, 1.0          # fraction of the step: lo stays below the cap, hi is above
+                full = adv - prev
+                for _ in range(bisect_iters):
+                    mid = (lo + hi) / 2
+                    cand = (prev + mid * full).detach()
+                    with torch.no_grad():
+                        m_mid = float(real_margin(pgd_model((cand - mean) / std)).item())
+                    if m_mid >= cap:
+                        hi = mid
+                    else:
+                        lo = mid
+                adv = (prev + hi * full).detach()
+                info["stopped_by_cap"] = True
+                info["bisected"] = True
+                break
     with torch.no_grad():
         info["margin_end"] = float(real_margin(pgd_model((adv - mean) / std)).item())
     return ((adv - mean) / std).detach(), info
@@ -356,7 +382,8 @@ def pgd_stage(pgd_model, x_norm, label, args, restore_eval, cap):
         out = run_pgd(pgd_model, args.pgd_eps, x_norm, label, restore_eval)
         return out, {"impl": "torchattacks", "steps": 10}
     out, info = pgd_own(pgd_model, x_norm, label, args.pgd_eps, args.pgd_alpha, args.pgd_steps,
-                        cap=cap, eot=args.pgd_eot, eot_jpeg_q=args.eot_jpeg_q, eot_resize=args.eot_resize)
+                        cap=cap, eot=args.pgd_eot, eot_jpeg_q=args.eot_jpeg_q, eot_resize=args.eot_resize,
+                        cap_bisect=args.cap_bisect, bisect_iters=args.bisect_iters)
     force_eval(restore_eval)
     info["impl"] = "own"
     return out, info
@@ -536,6 +563,9 @@ def main(argv=None):
     parser.add_argument("--pgd_steps", type=int, default=10, help="max steps of the own PGD loop")
     parser.add_argument("--cap", default="none", help="none | <float> | auto (median real-dev score of the surrogate)")
     parser.add_argument("--real_dev_dir", default="data/real/dev", help="real development images for --cap auto")
+    parser.add_argument("--cap_bisect", action="store_true",
+                        help="with --cap: when a PGD step crosses the cap, bisect the step so the score lands at the cap")
+    parser.add_argument("--bisect_iters", type=int, default=10)
     parser.add_argument("--pgd_eot", default="none", choices=["none", "jpeg", "resize", "both"])
     parser.add_argument("--lao_eot", default="none", choices=["none", "jpeg", "resize", "both"])
     parser.add_argument("--eot_jpeg_q", type=int, default=75)
diff --git a/StealthDiffusion/m3_run.sh b/StealthDiffusion/m3_run.sh
index e8054a0..a5abdaf 100644
--- a/StealthDiffusion/m3_run.sh
+++ b/StealthDiffusion/m3_run.sh
@@ -8,6 +8,7 @@
 #   bash m3_run.sh data15    # SD 1.5 data set, dev 10 / test 100, + real photos (Imagenette) -> data15/
 #   bash m3_run.sh t4        # T4: all T1 configurations + B10 / ENS / FULL on data15, 100 images (long, resumable)
 #   bash m3_run.sh t2        # T2: capped variant (own PGD, stop at the real-dev median score)   -> CAP_E, CAP_ENS
+#   bash m3_run.sh t2b       # T2b: capped variant with step bisection (lands at the cap)            -> CAPB_E, CAPB_ENS
 #   bash m3_run.sh t3        # T3: EOT (JPEG 75 + 0.5x resize) inside PGD                        -> EOT_E, EOT_ENS
 #   bash m3_run.sh t5        # T5: pixel PGD baseline, eps 8/255, step 2/255, 10 steps           -> PGD8
 #   bash m3_run.sh eval15    # evaluation of everything that exists under results/m3_sd15
@@ -102,6 +103,11 @@ EOF
     run_cfg "$R15" CAP_E   "${common15[@]}" "${cap[@]}"
     run_cfg "$R15" CAP_ENS "${common15[@]}" "${cap[@]}" --surrogates E,R,D
     ;;
+  t2b)   # capped variant with step bisection: the score lands at the cap instead of overshooting it
+    cap=(--pgd_impl own --cap auto --cap_bisect --real_dev_dir "$real_dev15" --pgd_alpha "$alpha_cap" --pgd_steps 40 --loss margin --kappa cap)
+    run_cfg "$R15" CAPB_E   "${common15[@]}" "${cap[@]}"
+    run_cfg "$R15" CAPB_ENS "${common15[@]}" "${cap[@]}" --surrogates E,R,D
+    ;;
   t3)
     eot=(--pgd_impl own --pgd_eot both --eot_jpeg_q 75 --eot_resize 0.5)
     run_cfg "$R15" EOT_E   "${common15[@]}" "${eot[@]}"
@@ -110,6 +116,19 @@ EOF
   t5)
     run_cfg "$R15" PGD8 "${common15[@]}" --pgd_only --pgd_impl own --pgd_eps "$($PY -c 'print(8/255)')" --pgd_alpha "$($PY -c 'print(2/255)')" --pgd_steps 10
     ;;
+  night)   # overnight batch, existing switches only: H1 on the ensemble, a second seed, EOT in the wrong place
+    for c in A2 X2 X4; do
+      echo "== [$(date '+%F %T')] ENS_$c" | tee -a "$LOG/$stage.log"
+      # shellcheck disable=SC2046
+      $PY m2_stealth.py "${common15[@]}" --surrogates E,R,D $(cfg_args "$c") --save_dir "$R15/ENS_$c" 2>&1 | tee -a "$LOG/$stage.log"
+    done
+    echo "== [$(date '+%F %T')] A5_seed43" | tee -a "$LOG/$stage.log"
+    $PY m2_stealth.py "${common15[@]}" --seed 43 --save_dir "$R15/A5_seed43" 2>&1 | tee -a "$LOG/$stage.log"
+    echo "== [$(date '+%F %T')] ENS_seed43" | tee -a "$LOG/$stage.log"
+    $PY m2_stealth.py "${common15[@]}" --seed 43 --surrogates E,R,D --save_dir "$R15/ENS_seed43" 2>&1 | tee -a "$LOG/$stage.log"
+    echo "== [$(date '+%F %T')] ENS_LAOEOT" | tee -a "$LOG/$stage.log"
+    $PY m2_stealth.py "${common15[@]}" --surrogates E,R,D --lao_eot both --save_dir "$R15/ENS_LAOEOT" 2>&1 | tee -a "$LOG/$stage.log"
+    ;;
   eval15)
     runs=()
     for d in "$R15"/*/; do n=$(basename "$d"); [ -f "$d/records.jsonl" ] && runs+=("$n=$d"); done
@@ -123,6 +142,6 @@ EOF
     done
     ls data15/gen/test 2>/dev/null | grep -c png | sed 's/^/data15\/gen\/test: /' || true
     ;;
-  *) echo "usage: bash m3_run.sh [t1|pgdcheck|data15|t4|t2|t3|t5|eval15|status]"; exit 1 ;;
+  *) echo "usage: bash m3_run.sh [t1|pgdcheck|data15|t4|t2|t2b|t3|t5|night|eval15|status]"; exit 1 ;;
 esac
 echo "[m3_run] stage '$stage' done $(date '+%F %T')" | tee -a "$LOG/$stage.log"
